  // --- chain : 5 edges [within a boundary] ---
  c_fnv_recorder -> c_ledgerjs [label="is-byte-compatible-with\\nquilt-claw/witness/ledger.js:6", color="#0f766e", style=solid, penwidth=2];
  c_ledger_rs -> c_fnv_recorder [label="diverges-from\\nquilt-rust/packages/core/src/ledger.rs:431", color="#0f766e", style=solid, penwidth=2];
  w_recorder -> c_fnv_recorder [label="is-chained-by\\nlabs/situation-recorder/recorder.py:90", color="#0f766e", style=solid, penwidth=2];
  w_charter -> c_fnv_recorder [label="is-chained-by\\nalgebra.md:76", color="#0f766e", style=solid, penwidth=2];
  c_ledgerjs -> w_reltypes [label="hosts\\nquilt-claw/witness/ledger.js:448", color="#0f766e", style=solid, penwidth=2];

  // --- media-model : 8 edges [within a boundary] ---
  med_subleq -> m_game [label="hosts\\nsrc/lib.rs:26", color="#1d4ed8", style=solid, penwidth=1];
  med_rust -> m_agent [label="hosts\\ncrates/quilt-polyformalism/src/lib.rs:72", color="#1d4ed8", style=solid, penwidth=1];
  med_c99 -> m_game [label="hosts\\nsubstrate/c/cell_algebra.c:5", color="#1d4ed8", style=solid, penwidth=1];
  med_ts -> m_spreadsheet [label="hosts\\nquilt/packages/core/src/types.ts:43", color="#1d4ed8", style=solid, penwidth=1];
  med_py -> m_openjev [label="hosts\\ncellular-first-design/code/openjev/cell.py:91", color="#1d4ed8", style=solid, penwidth=1];
  med_ts -> m_game [label="hosts\\ncargo-line-tycoon/substrate/ts/src/index.js:80", color="#1d4ed8", style=solid, penwidth=1];
  med_subleq -> m_spreadsheet [label="cannot-host\\nsrc/lib.rs:27", color="#1d4ed8", style=solid, penwidth=1];
  med_rust -> m_spreadsheet [label="cannot-host\\ncrates/quilt-polyformalism/src/lib.rs:37", color="#1d4ed8", style=solid, penwidth=1];

  // --- media-device : 1 edges [within a boundary] ---
