  m_corpus -> m_spreadsheet [label="contains\\ncellular-first-design/code/spreadsheet/spreadsheet_plugin.py:23", color="#78716c", style=solid, penwidth=1];

  // --- witness : 6 edges [within a boundary] ---
  w_charter -> w_recorder [label="is-unchained-relative-to\\nalgebra.md:72", color="#be123c", style=solid, penwidth=2];
