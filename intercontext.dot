  // --- claim-media : 9 edges [within a boundary] ---
  cl_opcodes -> med_ts [label="implemented-by\\nalgebra.md:13", color="#4338ca", style=solid, penwidth=1];
  cl_opcodes -> med_c99 [label="implemented-by\\nalgebra.md:13", color="#4338ca", style=solid, penwidth=1];
  cl_opcodes -> med_rust [label="implemented-by\\nalgebra.md:13", color="#4338ca", style=solid, penwidth=1];
  cl_opcodes -> med_py [label="implemented-by\\nalgebra.md:13", color="#4338ca", style=solid, penwidth=1];
  cl_opcodes -> med_subleq [label="implemented-by\\nalgebra.md:13", color="#4338ca", style=solid, penwidth=1];
  cl_poly -> med_subleq [label="media-listed-in\\nalgebra.md:143", color="#4338ca", style=solid, penwidth=1];
  cl_poly -> med_rust [label="media-listed-in\\nalgebra.md:143", color="#4338ca", style=solid, penwidth=1];
  cl_laws -> med_c99 [label="proved-partially-by\\nalgebra.md:26", color="#4338ca", style=solid, penwidth=1];
  cl_laws -> med_rust [label="proved-partially-by\\nalgebra.md:26", color="#4338ca", style=solid, penwidth=1];

  // --- claim-model : 7 edges [within a boundary] ---
  cl_kinds -> m_agent [label="implemented-by\\nalgebra.md:45", color="#4338ca", style=solid, penwidth=1];
  cl_kinds -> w_canon [label="validated-by\\nalgebra.md:45", color="#4338ca", style=solid, penwidth=1];
  cl_address -> m_spreadsheet [label="ADJACENT ONLY — NOT IMPLEMENTED\\nis-adjacent-to\\nalgebra.md:129", color="#a8a29e", style=dashed, penwidth=2];
  cl_address -> m_qthe [label="ADJACENT ONLY — NOT IMPLEMENTED\\nis-adjacent-to\\nalgebra.md:129", color="#a8a29e", style=dashed, penwidth=2];
  cl_address -> d_subleq_port [label="ADJACENT ONLY — NOT IMPLEMENTED\\nis-adjacent-to\\nalgebra.md:129", color="#a8a29e", style=dashed, penwidth=2];
  cl_id -> m_game [label="implemented-partially-by\\nalgebra.md:128", color="#4338ca", style=solid, penwidth=1];
