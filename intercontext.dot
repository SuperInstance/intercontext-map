// intercontext.dot
// The intercontext map — 48 nodes / 70 edges. Every node and edge carries a file+line
// or a commit sha. Machine-readable twin: intercontext.json (generated from the
// same object, so the two cannot disagree).
//
// Measured 2026-10-18 by Kira (Cartographer). Repos read at these heads:
//   SuperInstance/quilt                33b5d810d4a0  2026-10-15
//   SuperInstance/quilt-claw           165a49ab68b7  2026-10-17
//   SuperInstance/cargo-line-tycoon    595f6f320182  2026-10-03
//   SuperInstance/qthe                 adc378dc8b89  2026-10-18
//   SuperInstance/quilt-subleq         21efdd3dbce8  2026-09-24
//   SuperInstance/quilt-rust           ef3c3799047c  2026-09-29
//   SuperInstance/quilt-claw-cells-game 5ef7416cd214  2026-09-19
//   SuperInstance/AI-Writings          1da6180bb77a  2026-10-17
//   SuperInstance/quilt-cells          (2 files, no  2026-10-10
//
// GAPS ARE DRAWN AS GAPS. A claim with no edge to an implementation is drawn
// dashed, double-periphery and isolated. Do not connect it.
//
// EDGE CLASSES
//   thin grey   = inside one boundary (model<->model, claim<->claim)
//   thick org  = ORGANIZATION boundary crossing  (sketchbook -> org)
//   thick npm  = NPM SCOPE boundary crossing       (npm -> npm)
//   purple bld = ladder <-> witness (a rung is checkable only if witnessed)
//   teal       = chain family (hash algorithm)
//   crimson    = witness dialect drift
//
digraph intercontext {
  rankdir=LR; compound=true; fontname="Helvetica"; labelloc="t"; fontsize=20;
  label="INTERCONTEXT — the cellular-first substrate as a graph\n48 nodes / 70 edges / 15 boundary crossings\nID and ADDRESS are INDEPENDENT axes — no model has both\nMeasured 2026-10-18 · every node and edge cites a file:line or a commit sha";
  nodesep=0.42; ranksep=1.5; splines=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, margin="0.14,0.07"];
  edge [fontname="Helvetica", fontsize=7];

  subgraph cluster_models {
    label="  MODELS  "; color="#1d4ed8"; style="rounded"; penwidth=2; fontcolor="#1d4ed8"; fontsize=11;
    m_spreadsheet [label="the spreadsheet cell\n@quilt/core 0.3.0\nstring id e.g. \"compass.heading\"\n8 kinds, yaml+zod", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_agent [label="the agent cell\nquilt-claw\nNO address, NO hash-id\noutputs carry witness_hash", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_openjev [label="the openjev ancestor cell\nRANDOM identity: cell-\{uuid4[:8]\}\nA1 address via parse_address", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_game [label="the game's substrate\nFNV-1a-64 content hash\nin a method MISNAMED computeAddress()", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_qthe [label="qthe's lattice cell\n64-slot wormhole table\nADDRESS = (slot, x, y, resonance), NO hash", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_receipt [label="the receipt cell\nINPUT -\> OUTPUT + WHY + COST\ninput_hash/product_hash/activation/budget", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_quilt_cells [label="the cell-contract sketch\nINPUT -\> [CELL] -\> OUTPUT + WHY + COST\nDOCS ONLY, no code", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
    m_corpus [label="the demo corpus that changes under itself\n109+ demos under cellular-first-design/", fillcolor="#dbeafe", color="#1d4ed8", penwidth=2];
  }

  subgraph cluster_witness {
    label="  WITNESS  "; color="#be123c"; style="rounded"; penwidth=2; fontcolor="#be123c"; fontsize=11;
    w_charter [label="the charter's witness\n\{tick, op, cell, params, hash, prev_hash, sig\}\nCHAINED. result? ADDED 2026-10-18", fillcolor="#ffe4e6", color="#be123c", penwidth=2];
    w_canon [label="the live canon's witness\n\{id, opcode, cell_id, timestamp, payload_summary\}\nNO CHAIN. result on TICK only", fillcolor="#ffe4e6", color="#be123c", penwidth=2];
    w_recorder [label="the labs' witness\nDRAFT\{prompt, response, params\}\nCHAINED. CARRIES THE RESULT", fillcolor="#ffe4e6", color="#be123c", penwidth=2];
    w_openjev [label="openjev's witness (a FOURTH dialect, found by this map)\n\{ts, opcode:'WITNESS', value, source, jev_confidence\}\nNO hash, NO chain", fillcolor="#ffe4e6", color="#be123c", penwidth=2];
    w_reltypes [label="the recorder's NINE relations - a FOURTH opcode vocabulary\nTASK ROUTE DRAFT DRAW FOLD KEEP DROP MARK OUTCOME", fillcolor="#ffe4e6", color="#be123c", penwidth=2];
  }

  subgraph cluster_chains {
    label="  CHAINS  "; color="#0f766e"; style="rounded"; penwidth=2; fontcolor="#0f766e"; fontsize=11;
    c_fnv_recorder [label="fnv1a-64 chain (python)\nGENESIS via prev=None; verify() replays", fillcolor="#ccfbf1", color="#0f766e", penwidth=2];
    c_ledgerjs [label="fnv1a-64 chain (js)\nGENESIS '0x0000000000000000'\nbyte-compatible with recorder.py BY DESIGN", fillcolor="#ccfbf1", color="#0f766e", penwidth=2];
    c_ledger_rs [label="double-entry chain (rust)\nsha256, input/output postings, prev_hash\nAND `expected` - the prediction it was scored against", fillcolor="#ccfbf1", color="#0f766e", penwidth=2];
  }

  subgraph cluster_media {
    label="  MEDIA  "; color="#4338ca"; style="rounded"; penwidth=2; fontcolor="#4338ca"; fontsize=11;
    med_ts [label="TypeScript\nquilt-claw + @quilt/core\n6 of 11 opcodes dispatched", fillcolor="#e0e7ff", color="#4338ca", penwidth=2];
    med_c99 [label="C99\nsubstrate/c/cell_algebra.c\n5 opcodes + 2 of the 5 laws machine-checked", fillcolor="#e0e7ff", color="#4338ca", penwidth=2];
    med_py [label="Python\nopenjev/cell.py: BIND(:91) FORGET(:111) TICK(:121)\nsubstrate_cell_algebra.py: 0 dispatched", fillcolor="#e0e7ff", color="#4338ca", penwidth=2];
    med_rust [label="Rust\nquilt-polyformalism: Op enum, COUNT=9, WITH an Engine\nno_std-capable", fillcolor="#e0e7ff", color="#4338ca", penwidth=2];
    med_subleq [label="SUBLEQ - 1 instruction\nquilt-subleq\nBIND/LINK/EFFECT=1 instr, VIEW=2, 5 STUBBED\nHAS A REMOTE PORT", fillcolor="#e0e7ff", color="#4338ca", penwidth=2];
  }

  subgraph cluster_devices {
    label="  DEVICES  "; color="#0891b2"; style="rounded"; penwidth=2; fontcolor="#0891b2"; fontsize=11;
    d_subleq_port [label="the cell that calls OUT\nBlockRef::Port\{url, sig, encoding\}\nTHE FETCH IS MOCKED", fillcolor="#cffafe", color="#0891b2", penwidth=2];
    d_quilt_cells_call [label="the call-out, in PROSE\n'if a cell cannot fit on the vessel it gets a PHONE CALL'\nNO CODE", fillcolor="#cffafe", color="#0891b2", penwidth=2];
    d_rust_nostd [label="no_std Rust cell\nquilt-polyformalism: #![cfg_attr(not(test), no_std)]\n9 opcodes, an Engine, law checks", fillcolor="#cffafe", color="#0891b2", penwidth=2];
  }

  subgraph cluster_packages {
    label="  PACKAGES  "; color="#991b1b"; style="rounded"; penwidth=2; fontcolor="#991b1b"; fontsize=11;
    pkg_nine [label="NINE @quilt/* packages\nwant a scope they cannot have\nall HTTP 404 on npm", fillcolor="#fee2e2", color="#991b1b", penwidth=3];
  }

  // ---- claims and destinations with no cluster ----
  cl_opcodes [label="11 opcodes", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_kinds [label="26 kinds", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_address [label="Address = (x, y, t, sig)", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_lattice [label="4D lattice, three projections\nTOP x,y / FRONT signal / SIDE time", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_id [label="Cell ID = hash of (kind, payload, parents)", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_poly [label="Polyformalism = same model, 12 languages", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_nodb [label="Don't store cells in a DB.\nUse the witness log + derived state", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_laws [label="5 laws, proved in quilt-substrate-meta", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_witness [label="Witness log IS the substrate of truth", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_ladder [label="the measurement ladder\nstep -\> preds -\> labels", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  cl_result [label="a witness must carry the answer", fillcolor="#fef3c7", color="#92400e", penwidth=2];
  o_superinstance [label="SuperInstance\nSKETCHBOOK", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_patchwork [label="patchwork-quilt\nPRODUCTION", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_purple [label="purplepincher\nHARDENED", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_siready [label="si-ready\nEMPTY SHELF", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_luciddreamer [label="luciddreamer\nNAME HELD BY A USER", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_cocapn [label="cocapn\nGONE", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_quiltdata [label="quiltdata\nOCCUPIES @quilt", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  o_quiltorg [label="quilt\nUNRELATED", fillcolor="#f4f4f5", color="#3f3f46", penwidth=2];
  s_superinstance [label="@superinstance/*", fillcolor="#ffedd5", color="#9a3412", penwidth=2];
  s_quilt [label="@quilt/*", fillcolor="#ffedd5", color="#9a3412", penwidth=2];
  s_luciddreamer [label="@luciddreamer/*", fillcolor="#ffedd5", color="#9a3412", penwidth=2];
  s_cocapn [label="@cocapn/*", fillcolor="#ffedd5", color="#9a3412", penwidth=2];

  // ---- UNIMPLEMENTED CLAIMS: drawn dashed, double-periphery, NO EDGE ----
  cl_lattice [label="4D lattice, three projections\nTOP x,y / FRONT signal / SIDE time\n\n>>> NO IMPLEMENTATION ANYWHERE <<<\n0 edges in this graph", style="rounded,filled,dashed", peripheries=2, fillcolor="#f5f5f4", color="#a8a29e", penwidth=3, fontcolor="#57534e"];

  // ============================================================
  // EDGES — WITHIN a boundary: thin, quiet, already read.
  // ---- UNIMPLEMENTED CLAIMS: drawn dashed, double-periphery, NO EDGE ----
  cl_lattice [label="4D lattice, three projections\nTOP x,y / FRONT signal / SIDE time\n\n>>> NO IMPLEMENTATION ANYWHERE <<<\n0 edges in this graph", style="rounded,filled,dashed", peripheries=2, fillcolor="#f5f5f4", color="#a8a29e", penwidth=3, fontcolor="#57534e"];

  // ============================================================
  // --- cross-model : 4 edges [within a boundary] ---
  m_spreadsheet -> m_agent [label="shares-no-identity\\nquilt/packages/core/src/types.ts:43", color="#b45309", style=bold, penwidth=2];
  m_game -> m_spreadsheet [label="misnames-address-as-id\\ncargo-line-tycoon/substrate/ts/src/index.js:68", color="#b45309", style=bold, penwidth=2];
  m_openjev -> m_spreadsheet [label="inherits-address-style\\ncellular-first-design/code/spreadsheet/spreadsheet_plugin.py:23", color="#b45309", style=bold, penwidth=2];
  m_qthe -> m_game [label="inherits-x-y-tuple\\nqthe/qthe-core/kernel/qthe.mjs:102", color="#b45309", style=bold, penwidth=2];

  // --- model-claim : 3 edges [within a boundary] ---
  m_receipt -> cl_id [label="implements-partially\\nlabs/quilt-kernel/quilt_kernel.py:259", color="#78716c", style=solid, penwidth=1];
