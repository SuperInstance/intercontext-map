  w_canon -> w_charter [label="drifted-from\\n_worker.js:181", color="#be123c", style=solid, penwidth=2];
  w_recorder -> w_charter [label="is-superset-of\\nlabs/situation-recorder/recorder.py:104", color="#be123c", style=solid, penwidth=2];
